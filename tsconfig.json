// Standalone tsconfig — the compiler options previously inherited from the
// monorepo root tsconfig.json via `extends: "../../tsconfig.json"` are
// inlined here so this distribution builds and typechecks as a self-contained
// repository (required for the GitHub Pages CI, where no parent tsconfig
// exists). Keep in sync with the monorepo root tsconfig.json.
{
    "compilerOptions": {
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "allowJs": true,
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "strict": true,
        "lib": ["decorators", "dom", "es5", "scripthost", "es2015.collection"],
        "types": ["node", "vitest/globals"]
    },
    "exclude": ["node_modules", "**/*.test.ts", "**/dist/*", "**/lib/*"],
    // `scripts/**/*` is the CI helper folder run by `.github/workflows/deploy.yml`
    // through `npx vite-node scripts/ci-strip-dep.ts`; listing it here (narrow, not
    // `**/*`) is what puts that vite-node entrypoint under `tsc --noEmit` instead of
    // leaving CI to execute untypechecked sources. The `exclude` list only drops
    // node_modules/tests/dist/lib, so it does not fight this entry.
    "include": ["src/**/*", "scripts/**/*", "vite.config.ts", "vitest.config.ts"]
}
